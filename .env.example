# Copy to .env (git-ignored) and fill in DD_API_KEY and DD_APP_KEY.
# Simulator settings are in k8s/base/simulator.env (see "Demo scenarios" in the README).

# Datadog Agent
DD_API_KEY=
DD_SITE=datadoghq.com

# Datadog application key, used only by datadog/apply.sh on your machine to create the
# dashboard and monitors. It is never stored in the cluster.
DD_APP_KEY=
# Optional notification handle appended to every monitor message, e.g. @you@example.com
DD_NOTIFY=

# MongoDB connection string for the service (stored in the pulseops-mongodb Secret).
# The default is the in-cluster MongoDB; see "Using an external MongoDB" in the README.
MONGODB_URI=mongodb://mongodb:27017

# Password of the read-only "datadog" MongoDB user, used by the Datadog check of an external MongoDB
# (see "Using an external MongoDB" in the README). Not needed with the in-cluster MongoDB.
DD_MONGODB_PASSWORD=
