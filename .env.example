# Copy to .env (git-ignored) and fill in DD_API_KEY.
# Simulator settings are in k8s/base/simulator.env (see "Demo scenarios" in the README).

# Datadog Agent
DD_API_KEY=
DD_SITE=datadoghq.com

# MongoDB connection string for the service (stored in the pulseops-mongodb Secret).
# The default is the in-cluster MongoDB; see "Using an external MongoDB" in the README.
MONGODB_URI=mongodb://mongodb:27017
