{
  "title": "PulseOps – Pipeline & Observability",
  "description": "Ingestion latency, messages processed, pipeline errors (rejects, pauses, lag), service health, MongoDB and pipeline alerts.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**Pipeline & Observability** · Kafka → pulseops-service (2 replicas) → MongoDB. All widgets follow the time range at the top right. *No data* means the PulseOps cluster was not running: pick a range when it was (for example **Past 1 Day**). Widgets marked **ⓝ** use new metrics and show data once the new service version is deployed.",
        "background_color": "blue",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {
        "width": 12,
        "height": 2,
        "x": 0,
        "y": 0
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Avg processing latency",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "s",
                "query": "sum:pulseops.event_latency_seconds.sum{*}.as_count()",
                "aggregator": "sum"
              },
              {
                "data_source": "metrics",
                "name": "c",
                "query": "sum:pulseops.event_latency_seconds.count{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "s / c",
                "number_format": {
                  "unit": {
                    "type": "custom_unit_label",
                    "label": "s"
                  }
                }
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2
      },
      "layout": {
        "width": 2,
        "height": 2,
        "x": 0,
        "y": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Messages processed",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "c",
                "query": "sum:pulseops.event_latency_seconds.count{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "c"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "width": 2,
        "height": 2,
        "x": 2,
        "y": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Rejected messages",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "r",
                "query": "sum:pulseops.messages_rejected.count{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "default_zero(r)",
                "conditional_formats": [
                  {
                    "comparator": ">",
                    "value": 0,
                    "palette": "white_on_red"
                  },
                  {
                    "comparator": "<=",
                    "value": 0,
                    "palette": "white_on_green"
                  }
                ]
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "width": 2,
        "height": 2,
        "x": 4,
        "y": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Kafka lag (max)",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "l",
                "query": "sum:kafka.consumer_lag{consumer_group:pulseops-service}",
                "aggregator": "max"
              }
            ],
            "formulas": [
              {
                "formula": "l",
                "conditional_formats": [
                  {
                    "comparator": ">",
                    "value": 500,
                    "palette": "white_on_red"
                  },
                  {
                    "comparator": "<=",
                    "value": 500,
                    "palette": "white_on_green"
                  }
                ]
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "width": 2,
        "height": 2,
        "x": 6,
        "y": 2
      }
    },
    {
