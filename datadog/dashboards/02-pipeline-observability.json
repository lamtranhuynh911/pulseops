        "y": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Service replicas available",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "max:kubernetes_state.deployment.replicas_available{kube_namespace:pulseops,kube_deployment:pulseops-service}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "a",
                "conditional_formats": [
                  {
                    "comparator": "<",
                    "value": 2,
                    "palette": "white_on_red"
                  },
                  {
                    "comparator": ">=",
                    "value": 2,
                    "palette": "white_on_green"
                  }
                ]
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "width": 2,
        "height": 2,
        "x": 10,
        "y": 2
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Ingestion & latency",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Event processing latency (s, avg)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "s",
                      "query": "sum:pulseops.event_latency_seconds.sum{*}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:pulseops.event_latency_seconds.count{*}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "s / c",
                      "alias": "latency_s"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 5",
                  "display_type": "error dashed",
                  "label": "5s"
                }
              ]
            },
            "layout": {
              "width": 6,
              "height": 3,
              "x": 0,
              "y": 0
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Messages processed / min",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:pulseops.event_latency_seconds.count{*}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "c",
                      "alias": "messages"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "width": 6,
              "height": 3,
              "x": 6,
              "y": 0
            }
          },
          {
            "definition": {
