            "formulas": [
              {
                "formula": "p",
                "conditional_formats": [
                  {
                    "comparator": ">",
                    "value": 0,
                    "palette": "white_on_red"
                  },
                  {
                    "comparator": "<=",
                    "value": 0,
                    "palette": "white_on_green"
                  }
                ]
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "width": 2,
        "height": 2,
