# Simulator settings and fault injection (see "Demo scenarios" in the README). After editing, run
# kubectl apply -k k8s/overlays/<overlay>: the ConfigMap gets a new name, so a new simulator pod starts.
SIM_PRODUCT_INTERVAL_SECONDS=2
SIM_HEARTBEAT_INTERVAL_SECONDS=5
# Per machine: the test fails and the product leaves the line (no violation).
SIM_FAIL_RATE=0.03
# Per machine 1 and 2: the product bypasses the machine (MISSING_UPSTREAM at the next one).
SIM_SKIP_RATE=0
# Per machine 1 and 2: the product fails but keeps moving (FAILED_UPSTREAM at the next one).
SIM_LEAK_RATE=0
# Comma-separated machines that publish nothing at all, e.g. machine-2.
SIM_OFFLINE_MACHINES=
